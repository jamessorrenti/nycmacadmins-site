{{/* Content adapter: builds one page per event from data/events.json.
     data/events.json is synced from the Google Sheet by
     scripts/sync_events.py (see .github/workflows/events-sync.yaml) — the
     sheet is the single source of truth for events.

     Fields that overlap with macadmins-calendar (name, full_name,
     start_date, end_date, location, organizer, website, type, videos) use
     its exact field names at the data layer — see sync_events.py's
     docstring. ".name" maps to Hugo's own "title" page-dict key below;
     that's just Hugo's required internal key, not a data-layer rename. */}}
{{ range hugo.Data.events }}
  {{ if ne (.status | default "published") "draft" }}
    {{ $speakers := .speakers }}
    {{ if not (reflect.IsSlice $speakers) }}
      {{ $speakers = split (string ($speakers | default "")) "," }}
    {{ end }}
    {{ $page := dict
      "kind" "page"
      "path" .slug
      "title" .name
      "dates" (dict "date" (time.AsTime .start))
      "params" (dict
        "status" (.status | default "published")
        "full_name" (.full_name | default "")
        "start_date" (.start_date | default "")
        "end_date" (.end_date | default "")
        "location" (.location | default "")
        "organizer" (.organizer | default "")
        "website" (.website | default "")
        "type" (.type | default "meetup")
        "videos" (.videos | default "")
        "doors" (.doors | default "")
        "location_name" (.location_name | default "")
        "address" (.address | default "")
        "general_info" (.general_info | default "")
        "presentation_title" (.presentation_title | default "")
        "presentation_info" (.presentation_info | default "")
        "speakers" (apply $speakers "strings.TrimSpace" ".")
        "sponsor" (.sponsor | default "")
        "sponsor_info" (.sponsor_info | default "")
        "sponsor_link" (.sponsor_link | default "")
        "signup_link" (.signup_link | default "")
        "contact_email" (.contact_email | default "")
      )
      "content" (dict "mediaType" "text/markdown" "value" "")
    }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}
